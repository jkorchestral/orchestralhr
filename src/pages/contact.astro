---
import BaseLayout from "../layouts/BaseLayout.astro";
import Credit from "../components/Credit.astro";
import ContactForm from "../components/ContactForm.astro";

import { url } from "../lib/url";
---

<BaseLayout
  title="Contact | Orchestral HR Consulting"
  description="Book a conversation with Valerie Khan, a real look at what your business needs, no obligation."
  current="contact"
  ogImage="/assets/contact-coffee-chat.jpg"
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Let&rsquo;s talk about your people strategy.</h1>
      <p class="hero-sub">
        Book a conversation with Valerie, a real look at what your business needs, no obligation.
      </p>
    </div>
  </section>

  <section class="section section--flush">
    <div class="wrap">
      <div class="contact-grid reveal">
        <div>
          <h2 class="cform-heading" id="start">Start a conversation</h2>
          <p style="margin:14px 0 26px; color:var(--ink-soft); max-width:52ch; font-size:15.5px;">
            Every relationship starts with a short discovery conversation, no pressure, no obligation.
            If it&rsquo;s a fit, next steps are yours to decide.
          </p>
          <ContactForm />
        </div>
        <div class="contact-card">
          <h3>Direct</h3>
          <div class="contact-person">
            <h4>Valerie Khan</h4>
            <span class="role">Founder &amp; Executive Advisor</span>
            <div class="contact-line">
              <span>
                <span class="k">Email</span>
                <a href="mailto:Valerie@orchestralhr.ca">valerie@orchestralhr.ca</a>
              </span>
              <span>
                <span class="k">Based in</span>
                <span>Toronto, Ontario, serving clients across Canada</span>
              </span>
            </div>
          </div>
          <div class="contact-person">
            <h4>Chris Mendez</h4>
            <span class="role">Executive Advisor</span>
            <div class="contact-line">
              <span>
                <span class="k">Email</span>
                <a href="mailto:Chris.mendez@orchestralhr.ca">chris.mendez@orchestralhr.ca</a>
              </span>
              <span>
                <span class="k">Based in</span>
                <span>Edmonton, Alberta, serving clients across Canada</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <figure class="band band--contact reveal" style="margin-top:52px;">
        <img src={url("/assets/contact-coffee-chat.jpg")} width="1600" height="1067" loading="lazy" decoding="async"
             alt="Two people talking across a white table, each holding a grey ceramic mug." />
        <figcaption><span class="note">&#9834;</span> Every engagement starts with a conversation</figcaption>
      </figure>
      <Credit photographer="Priscilla Du Preez" href="https://unsplash.com/photos/two-people-holding-gray-mugs-at-table-K8XYGbw4Ahg" />
    </div>
  </section>
</BaseLayout>
