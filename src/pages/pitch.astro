---
import BaseLayout from "../layouts/BaseLayout.astro";
import Credit from "../components/Credit.astro";
import CtaBand from "../components/CtaBand.astro";
import { url } from "../lib/url";

const maybes = [
  "Maybe your organization is growing. Maybe your HR team is overwhelmed. Maybe you’re restructuring, integrating an acquisition or navigating a complex people challenge.",
  "Or maybe you’ve simply reached the point where the way you’ve always done things is no longer enough.",
];

const steps = [
  { glyph: "♪", term: "Diagnose" },
  { glyph: "♫", term: "Recommend" },
  { glyph: "♬", term: "Implement" },
];
---

<BaseLayout
  title="The Pitch | Orchestral HR Consulting"
  description="You don't need more HR. You need the right leadership, at the right time."
  current="pitch"
  ogImage="/assets/pitch-conductor.jpg"
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">The Pitch</span>
      <h1>You don&rsquo;t need more HR. You need the right leadership, at the right time.</h1>
    </div>
  </section>

  <div class="staff" role="presentation"><span>&#9834;</span></div>

  <section class="section section--flush" id="why-orchestral">
    <div class="wrap">
      <div class="split reveal">
        <div>
          <span class="section-num section-num--glyph">&#9833;</span>
          {maybes.map((m, i) => (
            <p class="section-dek" style={i === 0 ? "margin-top:0;" : undefined}>{m}</p>
          ))}
          <p class="pitch-turn">That&rsquo;s where Orchestral comes in.</p>
          <p class="section-dek">
            We bring experienced leadership, practical perspective and hands-on support to help
            organizations move forward.
          </p>
        </div>
        <figure class="pitch-figure">
          <span class="shot">
            <img src={url("/assets/pitch-conductor.jpg")} width="900" height="600" loading="lazy" decoding="async"
                 alt="A conductor&rsquo;s hands raising a baton above an open score on a warm wooden stage." />
          </span>
          <Credit photographer="Winston Chen" href="https://unsplash.com/photos/conductor-leading-orchestra-with-baton-over-sheet-music-IHb1waUfa3Q" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="approach">
    <div class="wrap">
      <ol class="pitch-steps stagger" aria-label="How Orchestral works">
        {steps.map((s) => (
          <li class="pitch-step"><span class="pitch-pill"><span class="note" aria-hidden="true">{s.glyph}</span>{s.term}</span></li>
        ))}
      </ol>
      <blockquote class="pull reveal" style="margin-top:34px;">
        Because good advice should lead to meaningful action.
      </blockquote>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
